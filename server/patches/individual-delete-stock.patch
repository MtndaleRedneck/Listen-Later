+/**
+ * Real-database proof (temp SQLite, the shipped Flyway migrations, real MyBatis mappers) for the
+ * Individual Videos removal. Transactions use Spring's TransactionTemplate over the same
+ * DataSourceTransactionManager rule as @Transactional (rollback on RuntimeException).
+ * No mocks for episode / playlist_episode. Synthetic rows only.
+ */
+class EpisodeServiceIndividualRemovalRealDbTest {
+  private static final String FEED = "individual-videos-youtube";
+  @TempDir Path dir;
+  SQLiteDataSource ds;
+  EpisodeService svc;
+  TransactionTemplate tx;
+  EpisodeMapper episodes;
+  PlaylistEpisodeMapper links;
+
+  private <T> T mapper(SqlSessionFactory f, Class<T> c) throws Exception {
+    MapperFactoryBean<T> b = new MapperFactoryBean<>(c);
+    b.setSqlSessionTemplate(new SqlSessionTemplate(f));
+    b.afterPropertiesSet();
+    return b.getObject();
+  }
+
+  @BeforeEach
+  void setUp() throws Exception {
+    ds = new SQLiteDataSource();
+    ds.setUrl("jdbc:sqlite:" + dir.resolve("t.db"));
+    Flyway.configure().dataSource(ds).locations("classpath:db/migration").load().migrate();
+    MybatisSqlSessionFactoryBean fb = new MybatisSqlSessionFactoryBean();
+    fb.setDataSource(ds);
+    fb.setConfiguration(new MybatisConfiguration());
+    SqlSessionFactory f = fb.getObject();
+    f.getConfiguration().addMapper(EpisodeMapper.class);
+    f.getConfiguration().addMapper(PlaylistEpisodeMapper.class);
+    episodes = mapper(f, EpisodeMapper.class);
+    links = mapper(f, PlaylistEpisodeMapper.class);
+    StorageProperties sp = Mockito.mock(StorageProperties.class);
+    Mockito.when(sp.isS3Mode()).thenReturn(false);
+    svc = new EpisodeService(episodes, Mockito.mock(org.springframework.context.ApplicationEventPublisher.class),
+        Mockito.mock(org.springframework.context.MessageSource.class), Mockito.mock(ChannelMapper.class), links,
+        Mockito.mock(PlaylistMapper.class), sp, Mockito.mock(S3StorageService.class),
+        Mockito.mock(DownloadProperties.class));
+    tx = new TransactionTemplate(new DataSourceTransactionManager(ds));
+    exec("PRAGMA foreign_keys=OFF");
+  }
+
+  void exec(String sql) throws Exception {
+    try (Connection c = ds.getConnection(); Statement s = c.createStatement()) { s.execute(sql); }
+  }
+
+  /** Insert a synthetic row, filling every other NOT NULL column without a default. */
+  void insert(String table, Map<String, String> v) throws Exception {
+    try (Connection c = ds.getConnection(); Statement s = c.createStatement()) {
+      List<String> cols = new ArrayList<>(); List<String> vals = new ArrayList<>();
+      try (ResultSet r = s.executeQuery("PRAGMA table_info(" + table + ")")) {
+        while (r.next()) {
+          String n = r.getString("name"); String t = r.getString("type").toUpperCase();
+          if (v.containsKey(n)) { cols.add(n); vals.add(v.get(n) == null ? "NULL" : "'" + v.get(n) + "'"); }
+          else if (r.getInt("notnull") == 1 && r.getString("dflt_value") == null) {
+            cols.add(n);
+            vals.add(t.contains("INT") || t.contains("REAL") ? "0" : t.contains("TIMESTAMP") ? "CURRENT_TIMESTAMP" : "'x'");
+          }
+        }
+      }
+      s.execute("INSERT INTO " + table + "(" + String.join(",", cols) + ") VALUES(" + String.join(",", vals) + ")");
+    }
+  }
+
+  long count(String sql) throws Exception {
+    try (Connection c = ds.getConnection(); Statement s = c.createStatement(); ResultSet r = s.executeQuery(sql)) {
+      r.next(); return r.getLong(1);
+    }
+  }
+
+  void feedEpisode(String id, String channelId, String status, String file) throws Exception {
+    insert("episode", Map.of("id", id, "channel_id", channelId == null ? "" : channelId,
