+  }
+
+  @Test
+  void episodeOutsideIndividualVideosIs422AndUntouched() {
+    when(episodeMapper.selectById("a")).thenReturn(episode("a", "COMPLETED", null));
+    when(playlistEpisodeMapper.countByPlaylistAndEpisode(FEED, "a")).thenReturn(0);
+    BusinessException ex = assertThrows(BusinessException.class,
+        () -> episodeService.removeFromIndividualVideos("a"));
+    assertEquals(Integer.valueOf(422), Integer.valueOf(ex.getCode()));
+    verify(playlistEpisodeMapper, never()).deleteMapping(anyString(), anyString());
+  }
+
+  @Test
+  void downloadingIs409AndUntouched() {
+    when(episodeMapper.selectById("a")).thenReturn(episode("a", "DOWNLOADING", null));
+    when(playlistEpisodeMapper.countByPlaylistAndEpisode(FEED, "a")).thenReturn(1);
+    BusinessException ex = assertThrows(BusinessException.class,
+        () -> episodeService.removeFromIndividualVideos("a"));
+    assertEquals(Integer.valueOf(409), Integer.valueOf(ex.getCode()));
+    verify(playlistEpisodeMapper, never()).deleteMapping(anyString(), anyString());
+  }
+
+  @Test
+  void downloaderClaimsRowAfterReadIs409() {
+    when(episodeMapper.selectById("a")).thenReturn(episode("a", "PENDING", null));
+    when(playlistEpisodeMapper.countByPlaylistAndEpisode(FEED, "a")).thenReturn(1);
+    when(playlistEpisodeMapper.isOrhanEpisode("a")).thenReturn(1L);
+    when(episodeMapper.deleteIfNotDownloading("a")).thenReturn(0);
+    BusinessException ex = assertThrows(BusinessException.class,
+        () -> episodeService.removeFromIndividualVideos("a"));
+    assertEquals(Integer.valueOf(409), Integer.valueOf(ex.getCode()));
+  }
+
+  @Test
+  void sharedEpisodeOnlyUnlinks() throws IOException {
+    Path media = tempDir.resolve("media.mp4");
+    Files.createFile(media);
+    when(episodeMapper.selectById("a")).thenReturn(episode("a", "COMPLETED", media.toString()));
+    when(playlistEpisodeMapper.countByPlaylistAndEpisode(FEED, "a")).thenReturn(1);
+    when(playlistEpisodeMapper.isOrhanEpisode("a")).thenReturn(0L);
+    assertEquals("unlinked", episodeService.removeFromIndividualVideos("a"));
+    verify(playlistEpisodeMapper).deleteMapping(FEED, "a");
+    verify(episodeMapper, never()).deleteIfNotDownloading(anyString());
+    assertTrue(Files.exists(media));
+  }
+
+  @Test
+  void orphanedCompletedEpisodeRemovesRowThenFiles() throws IOException {
+    Path media = tempDir.resolve("media.mp4");
+    Files.createFile(media);
+    Path thumb = tempDir.resolve("media.jpg");
+    Files.createFile(thumb);
+    when(episodeMapper.selectById("a")).thenReturn(episode("a", "COMPLETED", media.toString()));
+    when(playlistEpisodeMapper.countByPlaylistAndEpisode(FEED, "a")).thenReturn(1);
+    when(playlistEpisodeMapper.isOrhanEpisode("a")).thenReturn(1L);
+    when(episodeMapper.deleteIfNotDownloading("a")).thenReturn(1);
+    assertEquals("removed", episodeService.removeFromIndividualVideos("a"));
+    verify(playlistEpisodeMapper).deleteMapping(FEED, "a");
+    assertFalse(Files.exists(media));
+    assertFalse(Files.exists(thumb));
+  }
+}
diff --git a/backend/src/test/java/top/asimov/pigeon/service/EpisodeSidecarOwnershipTest.java b/backend/src/test/java/top/asimov/pigeon/service/EpisodeSidecarOwnershipTest.java
new file mode 100644
index 0000000..5daa5c9
--- /dev/null
+++ b/backend/src/test/java/top/asimov/pigeon/service/EpisodeSidecarOwnershipTest.java
@@ -0,0 +1,108 @@
+package top.asimov.pigeon.service;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.Mockito.lenient;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.junit.jupiter.api.io.TempDir;
+import org.mockito.Mock;
+import org.mockito.junit.jupiter.MockitoExtension;
+import org.springframework.context.ApplicationEventPublisher;
+import org.springframework.context.MessageSource;
+import top.asimov.pigeon.config.DownloadProperties;
+import top.asimov.pigeon.config.StorageProperties;
+import top.asimov.pigeon.mapper.ChannelMapper;
+import top.asimov.pigeon.mapper.EpisodeMapper;
+import top.asimov.pigeon.mapper.PlaylistEpisodeMapper;
+import top.asimov.pigeon.mapper.PlaylistMapper;
+import top.asimov.pigeon.service.storage.S3StorageService;
+
+/** Cleaning up one episode's sidecar files must not touch a different video's files. */
+@ExtendWith(MockitoExtension.class)
+class EpisodeSidecarOwnershipTest {
+
+  @Mock private EpisodeMapper episodeMapper;
+  @Mock private ApplicationEventPublisher eventPublisher;
+  @Mock private MessageSource messageSource;
+  @Mock private ChannelMapper channelMapper;
+  @Mock private PlaylistEpisodeMapper playlistEpisodeMapper;
+  @Mock private PlaylistMapper playlistMapper;
+  @Mock private StorageProperties storageProperties;
+  @Mock private S3StorageService s3StorageService;
+  @Mock private DownloadProperties downloadProperties;
+
+  private EpisodeService episodeService;
+
+  @TempDir Path tempDir;
+
+  @BeforeEach
+  void setUp() {
+    lenient().when(storageProperties.isS3Mode()).thenReturn(false);
+    episodeService = new EpisodeService(episodeMapper, eventPublisher, messageSource, channelMapper,
+        playlistEpisodeMapper, playlistMapper, storageProperties, s3StorageService, downloadProperties);
+  }
+
+  private Path touch(String name) throws IOException {
+    return Files.createFile(tempDir.resolve(name));
+  }
+
+  @Test
+  void deletingTitleKeepsTheFilesOfTitleDotRemix() throws IOException {
+    Path media = touch("Title.m4a");
+    Path ownVtt = touch("Title.en.vtt");
+    Path ownBareVtt = touch("Title.vtt");
+    Path ownJpg = touch("Title.jpg");
+    Path otherMedia = touch("Title.Remix.m4a");
+    Path otherVtt = touch("Title.Remix.en.vtt");
+    Path otherVtt2 = touch("Title.Remix.vtt");
+    Path otherJpg = touch("Title.Remix.jpg");
+
+    episodeService.deleteSubtitleFiles(media.toString());
+    episodeService.deleteThumbnailFiles(media.toString());
+
+    assertFalse(Files.exists(ownVtt));
+    assertFalse(Files.exists(ownBareVtt));
+    assertFalse(Files.exists(ownJpg));
+    assertTrue(Files.exists(media), "the media file itself is not a sidecar");
+    assertTrue(Files.exists(otherMedia));
+    assertTrue(Files.exists(otherVtt));
+    assertTrue(Files.exists(otherVtt2));
+    assertTrue(Files.exists(otherJpg));
+  }
+
+  @Test
+  void languageSuffixedSubtitlesStillMatch() throws IOException {
+    Path media = touch("Talk-abc123.m4a");
+    Path en = touch("Talk-abc123.en.vtt");
+    Path ptBr = touch("Talk-abc123.pt-BR.srt");
+    Path zh = touch("Talk-abc123.zh-Hans.vtt");
+    Path orig = touch("Talk-abc123.en-orig.vtt");
+
+    episodeService.deleteSubtitleFiles(media.toString());
+
+    assertFalse(Files.exists(en));
+    assertFalse(Files.exists(ptBr));
+    assertFalse(Files.exists(zh));
+    assertFalse(Files.exists(orig));
+  }
+
+  @Test
+  void matchersRejectOtherVideosAndKeepOwnNames() {
+    assertTrue(EpisodeService.isSubtitleSidecar("A.en.vtt", "A"));
+    assertTrue(EpisodeService.isSubtitleSidecar("A.srt", "A"));
+    assertFalse(EpisodeService.isSubtitleSidecar("A.Remix.en.vtt", "A"));
+    assertFalse(EpisodeService.isSubtitleSidecar("A.Remix.vtt", "A"));
+    assertFalse(EpisodeService.isSubtitleSidecar("A.Live.srt", "A"));
+    assertFalse(EpisodeService.isSubtitleSidecar("AB.en.vtt", "A"));
+    assertTrue(EpisodeService.isThumbnailSidecar("A.jpg", "A"));
+    assertTrue(EpisodeService.isThumbnailSidecar("A.webp", "A"));
+    assertFalse(EpisodeService.isThumbnailSidecar("A.Remix.jpg", "A"));
+    assertFalse(EpisodeService.isThumbnailSidecar("A.en.png", "A"));
+  }
+}
diff --git a/backend/src/test/java/top/asimov/pigeon/service/IndividualRemovalSqlTest.java b/backend/src/test/java/top/asimov/pigeon/service/IndividualRemovalSqlTest.java
new file mode 100644
index 0000000..77a44ed
--- /dev/null
+++ b/backend/src/test/java/top/asimov/pigeon/service/IndividualRemovalSqlTest.java
@@ -0,0 +1,119 @@
+package top.asimov.pigeon.service;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.sql.Connection;
+import java.sql.DriverManager;
+import java.sql.PreparedStatement;
+import java.sql.ResultSet;
+import java.sql.Statement;
+import org.apache.ibatis.annotations.Delete;
+import org.apache.ibatis.annotations.Select;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.transaction.annotation.Transactional;
+import top.asimov.pigeon.exception.BusinessException;
+import top.asimov.pigeon.mapper.EpisodeMapper;
+import top.asimov.pigeon.mapper.PlaylistEpisodeMapper;
+
+/**
+ * Runs the real SQL strings of the removal mappers against a real SQLite database (the same driver
+ * the app uses), so channel-owned and shared episodes are decided by actual rows, not mocks.
+ */
+class IndividualRemovalSqlTest {
+
+  private Connection db;
+
+  @BeforeEach
+  void open() throws Exception {
+    db = DriverManager.getConnection("jdbc:sqlite::memory:");
+    try (Statement st = db.createStatement()) {
+      st.execute("CREATE TABLE channel (id TEXT PRIMARY KEY)");
+      st.execute("CREATE TABLE episode (id TEXT PRIMARY KEY, channel_id TEXT, download_status TEXT)");
+      st.execute("CREATE TABLE playlist_episode (playlist_id TEXT, episode_id TEXT)");
+      st.execute("INSERT INTO channel VALUES ('ch1')");
+    }
+  }
+
+  @AfterEach
+  void close() throws Exception { db.close(); }
+
+  private void exec(String sql) throws Exception {
+    try (Statement st = db.createStatement()) { st.execute(sql); }
+  }
+
+  private String sql(Class<?> mapper, String method) throws Exception {
+    for (var m : mapper.getMethods()) {
+      if (m.getName().equals(method)) {
+        Select s = m.getAnnotation(Select.class);
+        if (s != null) return String.join("", s.value()).replace("#{episodeId}", "?");
+        Delete d = m.getAnnotation(Delete.class);
+        assertNotNull(d);
+        return String.join("", d.value()).replace("#{id}", "?");
+      }
+    }
+    throw new AssertionError("no method " + method);
+  }
+
+  private long orphan(String id) throws Exception {
+    try (PreparedStatement ps = db.prepareStatement(sql(PlaylistEpisodeMapper.class, "isOrhanEpisode"))) {
+      ps.setString(1, id);
+      try (ResultSet rs = ps.executeQuery()) { rs.next(); return rs.getLong(1); }
+    }
+  }
+
+  private int deleteIfNotDownloading(String id) throws Exception {
+    try (PreparedStatement ps = db.prepareStatement(sql(EpisodeMapper.class, "deleteIfNotDownloading"))) {
+      ps.setString(1, id);
+      return ps.executeUpdate();
+    }
+  }
+
+  @Test
+  void plainIndividualVideoIsAnOrphanOnceUnlinked() throws Exception {
+    exec("INSERT INTO episode VALUES ('a', NULL, 'COMPLETED')");
+    assertEquals(1, orphan("a"));
+  }
+
+  @Test
+  void channelOwnedEpisodeIsNeverAnOrphanEvenWhenOnlyInTheIndividualFeed() throws Exception {
+    exec("INSERT INTO episode VALUES ('c', 'ch1', 'COMPLETED')");
+    assertEquals(0, orphan("c"));
+  }
+
+  @Test
+  void episodeOfADeletedChannelCountsAsOrphan() throws Exception {
+    exec("INSERT INTO episode VALUES ('d', 'gone', 'COMPLETED')");
+    assertEquals(1, orphan("d"));
+  }
+
+  @Test
+  void episodeStillInAnotherPlaylistIsNotAnOrphan() throws Exception {
+    exec("INSERT INTO episode VALUES ('p', NULL, 'COMPLETED')");
+    exec("INSERT INTO playlist_episode VALUES ('other', 'p')");
+    assertEquals(0, orphan("p"));
+  }
+
+  @Test
+  void guardedDeleteRefusesADownloadingRowAndDeletesOthers() throws Exception {
+    exec("INSERT INTO episode VALUES ('x', NULL, 'DOWNLOADING')");
+    exec("INSERT INTO episode VALUES ('y', NULL, 'READY')");
+    assertEquals(0, deleteIfNotDownloading("x"));
+    assertEquals(1, deleteIfNotDownloading("y"));
+  }
+
+  @Test
+  void aRefusedRemovalRollsTheUnlinkBack() throws Exception {
+    // The service throws BusinessException (a RuntimeException) from a @Transactional method with
+    // no noRollbackFor, so Spring's default rule rolls the unlink back.
+    assertTrue(RuntimeException.class.isAssignableFrom(BusinessException.class));
+    Transactional t = EpisodeService.class
+        .getMethod("removeFromIndividualVideos", String.class).getAnnotation(Transactional.class);
+    assertNotNull(t);
+    assertEquals(0, t.noRollbackFor().length);
+    assertEquals(0, t.noRollbackForClassName().length);
+  }
+}
