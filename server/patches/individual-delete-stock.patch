+    assertEquals(1, count("select count(*) from episode where id='e1'"));
+    assertEquals(0, count("select count(*) from playlist_episode where episode_id='e1'"));
+    assertTrue(Files.exists(f));
+  }
+
+  @Test
+  void episodeAlsoInAnotherPlaylistIsOnlyUnlinked() throws Exception {
+    Path f = dir.resolve("b.mp4"); Files.writeString(f, "x");
+    feedEpisode("e2", null, "COMPLETED", f.toString());
+    insert("playlist_episode", Map.of("playlist_id", "other", "episode_id", "e2"));
+    assertEquals("unlinked", tx.execute(s -> svc.removeFromIndividualVideos("e2")));
+    assertEquals(1, count("select count(*) from episode where id='e2'"));
+    assertEquals(1, count("select count(*) from playlist_episode where episode_id='e2'"));
+    assertTrue(Files.exists(f));
+  }
+
+  @Test
+  void orphanedCompletedEpisodeIsRemovedWithItsFile() throws Exception {
+    Path f = dir.resolve("c.mp4"); Files.writeString(f, "x");
+    feedEpisode("e3", null, "COMPLETED", f.toString());
