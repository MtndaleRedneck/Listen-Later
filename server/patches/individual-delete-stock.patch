+    assertEquals(0, count("select count(*) from playlist_episode where episode_id='e3'"));
+    assertFalse(Files.exists(f));
+  }
+
+  @Test
+  void downloadingIs409AndNothingChanges() throws Exception {
+    feedEpisode("e4", null, "DOWNLOADING", dir.resolve("d.mp4").toString());
+    BusinessException ex = assertThrows(BusinessException.class, () -> tx.execute(s -> svc.removeFromIndividualVideos("e4")));
+    assertEquals(409, ex.getCode());
+    assertEquals(1, count("select count(*) from episode where id='e4'"));
+    assertEquals(1, count("select count(*) from playlist_episode where episode_id='e4'"));
+  }
+
+  @Test
+  void downloaderClaimAfterUnlinkRollsTheUnlinkBack() throws Exception {
+    // The downloader marks the row DOWNLOADING between the service's read and its atomic delete:
+    // simulate by claiming inside the same transaction right after the unlink, via a mapper wrapper.
+    feedEpisode("e5", null, "PENDING", dir.resolve("e.mp4").toString());
+    PlaylistEpisodeMapper racing = Mockito.spy(links);
+    Mockito.doAnswer(inv -> { int r = links.deleteMapping(inv.getArgument(0), inv.getArgument(1));
+      // same transaction connection (SQLite single writer): the downloader's claim lands before our delete
+      Connection tc = org.springframework.jdbc.datasource.DataSourceUtils.getConnection(ds);
+      try (Statement st = tc.createStatement()) { st.execute("UPDATE episode SET download_status='DOWNLOADING' WHERE id='e5'"); }
+      catch (java.sql.SQLException e) { throw new IllegalStateException(e); }
+      return r; })
+        .when(racing).deleteMapping(Mockito.anyString(), Mockito.anyString());
+    StorageProperties sp = Mockito.mock(StorageProperties.class);
+    EpisodeService racy = new EpisodeService(episodes, Mockito.mock(org.springframework.context.ApplicationEventPublisher.class),
+        Mockito.mock(org.springframework.context.MessageSource.class), Mockito.mock(ChannelMapper.class), racing,
+        Mockito.mock(PlaylistMapper.class), sp, Mockito.mock(S3StorageService.class), Mockito.mock(DownloadProperties.class));
+    BusinessException ex = assertThrows(BusinessException.class, () -> tx.execute(s -> racy.removeFromIndividualVideos("e5")));
+    assertEquals(409, ex.getCode());
+    assertEquals(1, count("select count(*) from episode where id='e5'"));
+    assertEquals(1, count("select count(*) from playlist_episode where playlist_id='" + FEED + "' and episode_id='e5'"),
+        "unlink must be rolled back with the 409");
+  }
+
+  @Test
+  void notInFeedIs422AndUnknownIsIdempotent() throws Exception {
+    insert("episode", Map.of("id", "e6", "channel_id", "", "download_status", "COMPLETED"));
+    BusinessException ex = assertThrows(BusinessException.class, () -> tx.execute(s -> svc.removeFromIndividualVideos("e6")));
+    assertEquals(422, ex.getCode());
+    assertEquals(1, count("select count(*) from episode where id='e6'"));
+    assertEquals("already_gone", tx.execute(s -> svc.removeFromIndividualVideos("nope")));
+  }
+}
