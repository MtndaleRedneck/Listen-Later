@@ -0,0 +1,52 @@
+package top.asimov.pigeon.config;
+
+import cn.dev33.satoken.stp.StpUtil;
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.servlet.http.HttpServletResponse;
+import org.springframework.stereotype.Component;
+import org.springframework.web.servlet.HandlerInterceptor;
+import top.asimov.pigeon.mapper.UserMapper;
+import top.asimov.pigeon.model.entity.User;
+
+/**
+ * Credential-version fence. Login stamps the user row's auth_version into the token session
+ * (per-token metadata, never the shared account session). Every authenticated request compares
+ * the stamped version against the row's current auth_version via a single-row primary-key
+ * lookup (no cache). A password change bumps auth_version in the same SQL statement as the new
+ * password hash, so every session minted before the change - including a racing login that
+ * captured the pre-change version - is rejected and logged out on its next request. The fence
+ * lives in SQLite, not the session store, so recovering an old session-store snapshot cannot
+ * revive pre-change sessions. Tokens without a stamped version (pre-rollout sessions) are
+ * rejected: one re-login at rollout. A request already past this check when the bump commits
+ * cannot be cancelled retroactively; the boundary is per-request from commit onward.
+ */
+@Component
+public class AuthVersionInterceptor implements HandlerInterceptor {
+
+  public static final String SESSION_AUTH_VERSION_KEY = "authVersion";
+
+  private final UserMapper userMapper;
+  private final AuthProperties authProperties;
+
+  public AuthVersionInterceptor(UserMapper userMapper, AuthProperties authProperties) {
+    this.userMapper = userMapper;
+    this.authProperties = authProperties;
+  }
+
+  @Override
+  public boolean preHandle(HttpServletRequest request, HttpServletResponse response,
+      Object handler) {
+    if (!authProperties.isEnabled() || !StpUtil.isLogin()) {
+      return true;
+    }
+    Object stamped = StpUtil.getTokenSession().get(SESSION_AUTH_VERSION_KEY);
+    User current = userMapper.selectById(StpUtil.getLoginIdAsString());
+    long currentVersion =
+        current == null || current.getAuthVersion() == null ? -1L : current.getAuthVersion();
+    if (!(stamped instanceof Number) || ((Number) stamped).longValue() != currentVersion) {
+      StpUtil.logoutByTokenValue(StpUtil.getTokenValue());
+      StpUtil.checkLogin();
+    }
+    return true;
+  }
+}
