+  /**
+   * Session store (Redis) failures: HTTP 503, generic message to clients,
+   * exception detail logged server-side only. Narrow types on purpose:
+   * never blanket DataAccessException, so unrelated DB errors and genuine
+   * 401s keep their current handling.
+   */
+  @ExceptionHandler({RedisConnectionFailureException.class, RedisSystemException.class,
+      QueryTimeoutException.class})
+  @ResponseStatus(HttpStatus.SERVICE_UNAVAILABLE)
+  public SaResult handleSessionStoreException(RuntimeException e) {
+    log.warn("[session-store] unavailable: type={}", e.getClass().getSimpleName(), e);
+    return SaResult.code(503).setMsg("Session store temporarily unavailable, please retry");
+  }
+
