+
+@ExtendWith(MockitoExtension.class)
+class EpisodeServiceIndividualRemovalTest {
+
+  @Mock
+  private EpisodeMapper episodeMapper;
+
+  @Mock
+  private ApplicationEventPublisher eventPublisher;
+
+  @Mock
+  private MessageSource messageSource;
+
+  @Mock
+  private ChannelMapper channelMapper;
+
+  @Mock
+  private PlaylistEpisodeMapper playlistEpisodeMapper;
+
+  @Mock
+  private PlaylistMapper playlistMapper;
+
+  @Mock
+  private StorageProperties storageProperties;
+
+  @Mock
+  private S3StorageService s3StorageService;
+
+  @Mock
+  private DownloadProperties downloadProperties;
+
+  private EpisodeService episodeService;
+
+  @TempDir
+  Path tempDir;
+
+  @BeforeEach
+  void setUp() {
+    org.mockito.Mockito.lenient().when(storageProperties.isS3Mode()).thenReturn(false);
+    episodeService = new EpisodeService(
+        episodeMapper,
+        eventPublisher,
+        messageSource,
+        channelMapper,
+        playlistEpisodeMapper,
+        playlistMapper,
+        storageProperties,
+        s3StorageService,
+        downloadProperties
+    );
+  }
+
+  private static final String FEED = "individual-videos-youtube";
+
+  private Episode episode(String id, String status, String path) {
+    Episode e = new Episode();
+    e.setId(id);
+    e.setDownloadStatus(status);
+    e.setMediaFilePath(path);
+    return e;
+  }
+
+  @Test
+  void unknownIdIsIdempotentAndTouchesNothing() {
+    when(episodeMapper.selectById("x")).thenReturn(null);
+    assertEquals("already_gone", episodeService.removeFromIndividualVideos("x"));
+    verify(playlistEpisodeMapper, never()).deleteMapping(anyString(), anyString());
+    verify(episodeMapper, never()).deleteIfNotDownloading(anyString());
+  }
+
+  @Test
+  void episodeOutsideIndividualVideosIs422AndUntouched() {
+    when(episodeMapper.selectById("a")).thenReturn(episode("a", "COMPLETED", null));
+    when(playlistEpisodeMapper.countByPlaylistAndEpisode(FEED, "a")).thenReturn(0);
+    BusinessException ex = assertThrows(BusinessException.class,
+        () -> episodeService.removeFromIndividualVideos("a"));
+    assertEquals(Integer.valueOf(422), Integer.valueOf(ex.getCode()));
+    verify(playlistEpisodeMapper, never()).deleteMapping(anyString(), anyString());
+  }
+
+  @Test
+  void downloadingIs409AndUntouched() {
+    when(episodeMapper.selectById("a")).thenReturn(episode("a", "DOWNLOADING", null));
+    when(playlistEpisodeMapper.countByPlaylistAndEpisode(FEED, "a")).thenReturn(1);
+    BusinessException ex = assertThrows(BusinessException.class,
+        () -> episodeService.removeFromIndividualVideos("a"));
+    assertEquals(Integer.valueOf(409), Integer.valueOf(ex.getCode()));
+    verify(playlistEpisodeMapper, never()).deleteMapping(anyString(), anyString());
+  }
+
+  @Test
+  void downloaderClaimsRowAfterReadIs409() {
+    when(episodeMapper.selectById("a")).thenReturn(episode("a", "PENDING", null));
+    when(playlistEpisodeMapper.countByPlaylistAndEpisode(FEED, "a")).thenReturn(1);
+    when(playlistEpisodeMapper.isOrhanEpisode("a")).thenReturn(1L);
+    when(episodeMapper.deleteIfNotDownloading("a")).thenReturn(0);
+    BusinessException ex = assertThrows(BusinessException.class,
+        () -> episodeService.removeFromIndividualVideos("a"));
+    assertEquals(Integer.valueOf(409), Integer.valueOf(ex.getCode()));
+  }
+
+  @Test
+  void sharedEpisodeOnlyUnlinks() throws IOException {
+    Path media = tempDir.resolve("media.mp4");
+    Files.createFile(media);
+    when(episodeMapper.selectById("a")).thenReturn(episode("a", "COMPLETED", media.toString()));
+    when(playlistEpisodeMapper.countByPlaylistAndEpisode(FEED, "a")).thenReturn(1);
+    when(playlistEpisodeMapper.isOrhanEpisode("a")).thenReturn(0L);
+    assertEquals("unlinked", episodeService.removeFromIndividualVideos("a"));
+    verify(playlistEpisodeMapper).deleteMapping(FEED, "a");
+    verify(episodeMapper, never()).deleteIfNotDownloading(anyString());
+    assertTrue(Files.exists(media));
+  }
+
+  @Test
+  void orphanedCompletedEpisodeRemovesRowThenFiles() throws IOException {
+    Path media = tempDir.resolve("media.mp4");
+    Files.createFile(media);
+    Path thumb = tempDir.resolve("media.jpg");
+    Files.createFile(thumb);
+    when(episodeMapper.selectById("a")).thenReturn(episode("a", "COMPLETED", media.toString()));
+    when(playlistEpisodeMapper.countByPlaylistAndEpisode(FEED, "a")).thenReturn(1);
+    when(playlistEpisodeMapper.isOrhanEpisode("a")).thenReturn(1L);
+    when(episodeMapper.deleteIfNotDownloading("a")).thenReturn(1);
+    assertEquals("removed", episodeService.removeFromIndividualVideos("a"));
+    verify(playlistEpisodeMapper).deleteMapping(FEED, "a");
+    assertFalse(Files.exists(media));
+    assertFalse(Files.exists(thumb));
+  }
+}
