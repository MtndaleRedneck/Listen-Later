@@ -0,0 +1,119 @@
+package top.asimov.pigeon.service;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.sql.Connection;
+import java.sql.DriverManager;
+import java.sql.PreparedStatement;
+import java.sql.ResultSet;
+import java.sql.Statement;
+import org.apache.ibatis.annotations.Delete;
+import org.apache.ibatis.annotations.Select;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.transaction.annotation.Transactional;
+import top.asimov.pigeon.exception.BusinessException;
+import top.asimov.pigeon.mapper.EpisodeMapper;
+import top.asimov.pigeon.mapper.PlaylistEpisodeMapper;
+
+/**
+ * Runs the real SQL strings of the removal mappers against a real SQLite database (the same driver
+ * the app uses), so channel-owned and shared episodes are decided by actual rows, not mocks.
+ */
+class IndividualRemovalSqlTest {
+
+  private Connection db;
+
+  @BeforeEach
+  void open() throws Exception {
+    db = DriverManager.getConnection("jdbc:sqlite::memory:");
+    try (Statement st = db.createStatement()) {
+      st.execute("CREATE TABLE channel (id TEXT PRIMARY KEY)");
+      st.execute("CREATE TABLE episode (id TEXT PRIMARY KEY, channel_id TEXT, download_status TEXT)");
+      st.execute("CREATE TABLE playlist_episode (playlist_id TEXT, episode_id TEXT)");
+      st.execute("INSERT INTO channel VALUES ('ch1')");
+    }
+  }
+
+  @AfterEach
+  void close() throws Exception { db.close(); }
+
+  private void exec(String sql) throws Exception {
+    try (Statement st = db.createStatement()) { st.execute(sql); }
+  }
+
+  private String sql(Class<?> mapper, String method) throws Exception {
+    for (var m : mapper.getMethods()) {
+      if (m.getName().equals(method)) {
+        Select s = m.getAnnotation(Select.class);
+        if (s != null) return String.join("", s.value()).replace("#{episodeId}", "?");
+        Delete d = m.getAnnotation(Delete.class);
+        assertNotNull(d);
+        return String.join("", d.value()).replace("#{id}", "?");
+      }
+    }
+    throw new AssertionError("no method " + method);
+  }
+
+  private long orphan(String id) throws Exception {
+    try (PreparedStatement ps = db.prepareStatement(sql(PlaylistEpisodeMapper.class, "isOrhanEpisode"))) {
+      ps.setString(1, id);
+      try (ResultSet rs = ps.executeQuery()) { rs.next(); return rs.getLong(1); }
+    }
+  }
+
+  private int deleteIfNotDownloading(String id) throws Exception {
+    try (PreparedStatement ps = db.prepareStatement(sql(EpisodeMapper.class, "deleteIfNotDownloading"))) {
+      ps.setString(1, id);
+      return ps.executeUpdate();
+    }
+  }
+
+  @Test
+  void plainIndividualVideoIsAnOrphanOnceUnlinked() throws Exception {
+    exec("INSERT INTO episode VALUES ('a', NULL, 'COMPLETED')");
+    assertEquals(1, orphan("a"));
+  }
+
+  @Test
+  void channelOwnedEpisodeIsNeverAnOrphanEvenWhenOnlyInTheIndividualFeed() throws Exception {
+    exec("INSERT INTO episode VALUES ('c', 'ch1', 'COMPLETED')");
+    assertEquals(0, orphan("c"));
+  }
+
+  @Test
+  void episodeOfADeletedChannelCountsAsOrphan() throws Exception {
+    exec("INSERT INTO episode VALUES ('d', 'gone', 'COMPLETED')");
+    assertEquals(1, orphan("d"));
+  }
+
+  @Test
+  void episodeStillInAnotherPlaylistIsNotAnOrphan() throws Exception {
+    exec("INSERT INTO episode VALUES ('p', NULL, 'COMPLETED')");
+    exec("INSERT INTO playlist_episode VALUES ('other', 'p')");
+    assertEquals(0, orphan("p"));
+  }
+
+  @Test
+  void guardedDeleteRefusesADownloadingRowAndDeletesOthers() throws Exception {
+    exec("INSERT INTO episode VALUES ('x', NULL, 'DOWNLOADING')");
+    exec("INSERT INTO episode VALUES ('y', NULL, 'READY')");
+    assertEquals(0, deleteIfNotDownloading("x"));
+    assertEquals(1, deleteIfNotDownloading("y"));
+  }
+
+  @Test
+  void aRefusedRemovalRollsTheUnlinkBack() throws Exception {
+    // The service throws BusinessException (a RuntimeException) from a @Transactional method with
+    // no noRollbackFor, so Spring's default rule rolls the unlink back.
+    assertTrue(RuntimeException.class.isAssignableFrom(BusinessException.class));
+    Transactional t = EpisodeService.class
+        .getMethod("removeFromIndividualVideos", String.class).getAnnotation(Transactional.class);
+    assertNotNull(t);
+    assertEquals(0, t.noRollbackFor().length);
+    assertEquals(0, t.noRollbackForClassName().length);
+  }
+}
