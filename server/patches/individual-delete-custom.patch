+  /**
+   * Removes one episode from the Individual Videos feed only, in one transaction.
+   * Unknown id: \"already_gone\" (the episode does not exist; says nothing about why). Not in this feed: 422, nothing touched (never 404, which a client reads as a missing route).
+   * Downloading: 409, nothing touched. PENDING is removed directly (no separate cancel).
+   * If another playlist or channel still uses the episode, only the feed link is removed.
+   * Otherwise the row is deleted atomically (refused if the downloader claimed it meanwhile),
+   * then its files are removed after the transaction commits.
+   */
+  @Transactional
+  public String removeFromIndividualVideos(String id) {
+    Episode episode = episodeMapper.selectById(id);
+    if (episode == null) {
+      return "already_gone";
+    }
+    String feedId = IndividualVideoPlaylistSupport.PLAYLIST_ID;
+    if (playlistEpisodeMapper.countByPlaylistAndEpisode(feedId, id) == 0) {
+      throw new BusinessException(422, "Episode is not in the Individual Videos feed");
+    }
+    if (EpisodeStatus.DOWNLOADING.name().equals(episode.getDownloadStatus())) {
+      throw new BusinessException(409, "Episode is downloading right now. Try again shortly.");
+    }
+    String mediaFilePath = episode.getMediaFilePath();
+    playlistEpisodeMapper.deleteMapping(feedId, id);
+    if (playlistEpisodeMapper.isOrhanEpisode(id) == 0) {
+      return "unlinked"; // still used elsewhere
+    }
+    if (episodeMapper.deleteIfNotDownloading(id) == 0) {
+      // downloader claimed it after our read: abort and roll back the unlink
+      throw new BusinessException(409, "Episode is downloading right now. Try again shortly.");
+    }
+    // Files go only after the database change has committed, so a failed commit can't leave
+    // rows pointing at deleted files. Outside a transaction (unit tests) it runs immediately.
+    Runnable cleanup = () -> deleteFilesAfterRowRemoval(id, mediaFilePath);
+    if (TransactionSynchronizationManager.isSynchronizationActive()) {
+      TransactionSynchronizationManager.registerSynchronization(new TransactionSynchronization() {
+        @Override
+        public void afterCommit() {
+          cleanup.run();
+        }
+      });
+    } else {
+      cleanup.run();
+    }
+    return "removed";
+  }
+
+  /**
+   * Removes only files whose name is exactly this video's base name plus a plain subtitle or image
+   * extension. Files like "<base>.en.vtt" are left in place: a name that starts with "<base>."
+   * cannot be proven to belong to this video rather than to a different one, and this delete
+   * never removes a file it cannot prove is its own.
+   */
+  private void deleteOwnSidecarFiles(String mediaFilePath) throws java.io.IOException {
+    Path mediaPath = Paths.get(mediaFilePath);
+    Path parent = mediaPath.getParent();
+    if (parent == null) {
+      return;
+    }
+    String fileName = mediaPath.getFileName().toString();
+    int dotIndex = fileName.lastIndexOf('.');
+    String baseName = dotIndex > 0 ? fileName.substring(0, dotIndex) : fileName;
+    for (String ext : new String[] {".vtt", ".srt", ".jpg", ".jpeg", ".png", ".webp"}) {
+      String sidecar = baseName + ext;
+      if (!sidecar.equals(fileName)) {
+        Files.deleteIfExists(parent.resolve(sidecar));
+      }
+    }
+  }
+
+  void deleteFilesAfterRowRemoval(String id, String mediaFilePath) {
+    try {
+      if (isS3Mode()) {
+        deleteEpisodeAssetsByMediaPath(mediaFilePath);
+      } else if (StringUtils.hasText(mediaFilePath)) {
+        deleteOwnSidecarFiles(mediaFilePath);
+        deleteChaptersFile(mediaFilePath, id);
+        Files.deleteIfExists(Paths.get(mediaFilePath));
+      }
+    } catch (Exception e) {
+      // the row is already gone; a leftover file is logged, never shown as a failure
+      log.error("[storage] file delete failed after row delete: episodeId={} filePath={}",
+          id, mediaFilePath, e);
+    }
+  }
