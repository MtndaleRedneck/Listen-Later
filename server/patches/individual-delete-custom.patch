+import top.asimov.pigeon.mapper.PlaylistMapper;
+import top.asimov.pigeon.service.storage.S3StorageService;
+
+/** Cleaning up one episode's sidecar files must not touch a different video's files. */
+@ExtendWith(MockitoExtension.class)
+class EpisodeSidecarOwnershipTest {
+
+  @Mock private EpisodeMapper episodeMapper;
+  @Mock private ApplicationEventPublisher eventPublisher;
+  @Mock private MessageSource messageSource;
+  @Mock private ChannelMapper channelMapper;
+  @Mock private PlaylistEpisodeMapper playlistEpisodeMapper;
+  @Mock private PlaylistMapper playlistMapper;
+  @Mock private StorageProperties storageProperties;
+  @Mock private S3StorageService s3StorageService;
+  @Mock private DownloadProperties downloadProperties;
+
+  private EpisodeService episodeService;
+
+  @TempDir Path tempDir;
+
+  @BeforeEach
+  void setUp() {
+    lenient().when(storageProperties.isS3Mode()).thenReturn(false);
+    episodeService = new EpisodeService(episodeMapper, eventPublisher, messageSource, channelMapper,
+        playlistEpisodeMapper, playlistMapper, storageProperties, s3StorageService, downloadProperties);
+  }
+
+  private Path touch(String name) throws IOException {
+    return Files.createFile(tempDir.resolve(name));
+  }
+
+  @Test
+  void removalDeletesOnlyTheExactOwnFiles() throws IOException {
+    Path media = touch("Title.m4a");
+    Path ownBareVtt = touch("Title.vtt");
+    Path ownSrt = touch("Title.srt");
+    Path ownJpg = touch("Title.jpg");
+    Path ownWebp = touch("Title.webp");
+    Path chapters = touch("Title.chapters.json");
+
+    episodeService.deleteFilesAfterRowRemoval("ep-1", media.toString());
+
+    assertFalse(Files.exists(media));
+    assertFalse(Files.exists(ownBareVtt));
+    assertFalse(Files.exists(ownSrt));
+    assertFalse(Files.exists(ownJpg));
+    assertFalse(Files.exists(ownWebp));
+    assertFalse(Files.exists(chapters));
+  }
+
+  @Test
+  void removalNeverTouchesFilesOfNamesThatOnlyStartWithTheBaseName() throws IOException {
+    Path media = touch("Title.m4a");
+    Path otherMedia = touch("Title.Remix.m4a");
+    Path otherVtt = touch("Title.Remix.en.vtt");
+    Path otherVtt2 = touch("Title.Remix.vtt");
+    Path otherJpg = touch("Title.Remix.jpg");
+    Path ptVtt = touch("Title.Pt.vtt");
+    Path enVtt = touch("Title.en.vtt");
+    Path enSrt = touch("Title.en.srt");
+    Path otherChapters = touch("Title.Remix.chapters.json");
+    Path hyphenSibling = touch("Title-2.m4a");
+    Path hyphenSiblingVtt = touch("Title-2.vtt");
+
+    episodeService.deleteFilesAfterRowRemoval("ep-1", media.toString());
+
+    assertFalse(Files.exists(media));
+    for (Path kept : new Path[] {otherMedia, otherVtt, otherVtt2, otherJpg, ptVtt, enVtt, enSrt,
+        otherChapters, hyphenSibling, hyphenSiblingVtt}) {
+      assertTrue(Files.exists(kept), kept.getFileName() + " must be kept");
+    }
+  }
+}
